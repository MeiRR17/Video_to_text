# macOS
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
temp_audio/
*.tmp
*.temp

# Output files - keep transcripts but ignore temp files
output/*
!output/.gitkeep
!output/**/*.txt
!output/**/*.srt
!output/**/*.vtt

# Input videos (user content)
Input/*
!Input/.gitkeep

# Test files
test_single.wav
*.test

# whisper.cpp (install separately per README)
whisper.cpp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
